# Network Settings
HOST=0.0.0.0
PORT=8000

# Mode: mock = จำลองเหตุการณ์ | live = ใช้ sniffer จริง (Phase 2)
MODE=mock
MOCK_INTERVAL_SEC=6

# รหัสสำหรับ endpoint ควบคุม (เช่น /api/simulate) เว้นว่าง = ไม่ต้องใช้รหัส
DASHBOARD_TOKEN=

# LINE Messaging API (เว้นว่างไว้สำหรับใส่ภายหลัง)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
LINE_ALERT_ENABLED=true
# ไม่ส่งซ้ำ (ประเภท + MAC เดิม) ภายในกี่วินาที
LINE_THROTTLE_SEC=60